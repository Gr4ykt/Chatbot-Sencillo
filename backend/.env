# ===== EC2 #1: backend (FastAPI + Ollama) =====

# Modelo pequeño que corre en CPU dentro del contenedor de Ollama
OLLAMA_MODEL=qwen2.5:1.5b

# Tiempo que el modelo permanece cargado en RAM tras la última consulta
OLLAMA_KEEP_ALIVE=30m

# Contexto del modelo: más bajo = menos RAM (importante con 2 GB)
NUM_CTX=2048

# Máximo de mensajes de historial enviados al modelo
MAX_MESSAGES=20

# Segundos máximos esperando respuesta de Ollama
READ_TIMEOUT=300

SYSTEM_PROMPT="Eres un asistente útil y conciso. Responde siempre en español."

# Solo necesario si el frontend se sirve desde otro origen (en producción
# Nginx hace de proxy y no hace falta). Lista separada por comas.
ALLOWED_ORIGINS=